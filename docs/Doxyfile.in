PROJECT_NAME           = "Apache Strap-Down Pilotage Render Module"
STRIP_FROM_PATH        = "@CMAKE_CURRENT_SOURCE_DIR@"
OUTPUT_DIRECTORY       = "@CMAKE_CURRENT_BINARY_DIR@/doc_doxygen/"
INPUT                  = "@CMAKE_CURRENT_SOURCE_DIR@/" "@CMAKE_CURRENT_SOURCE_DIR@/docs"
#EXAMPLE_PATH           = "@CMAKE_CURRENT_SOURCE_DIR@/examples" "@CMAKE_CURRENT_SOURCE_DIR@/tests_cpp"
IMAGE_PATH             = "@CMAKE_CURRENT_SOURCE_DIR@"
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
RECURSIVE              = YES
#EXCLUDE               = dependencies
EXCLUDE_PATTERNS       = "@CMAKE_CURRENT_SOURCE_DIR@/dependencies/*" "@CMAKE_CURRENT_SOURCE_DIR@/gfxwrapper/*"
USE_MDFILE_AS_MAINPAGE = "@CMAKE_CURRENT_SOURCE_DIR@/README.md"
